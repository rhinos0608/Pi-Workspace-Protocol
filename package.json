{
  "name": "@rhinos0608/pi-workspace-protocol",
  "version": "0.3.0",
  "description": "Versioned serializable contracts, codecs, ID helpers, and event-RPC types for the Pi SmartRead/SmartEdit inspect+patch protocol.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --import tsx 'test/**/*.test.ts'",
    "prepare": "npm run build"
  },
  "engines": { "node": ">=20" },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2"
  },
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rhinos0608/Pi-Workspace-Protocol.git"
  }
}
